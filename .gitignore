# Dependencies and generated output
node_modules/
**/node_modules/
dist/
build/
coverage/

# Logs and local runtime data
*.log
logs/
*.pid
*.seed
*.pid.lock

# Environment secrets (keep placeholder templates such as .env.example)
.env
.env.*
!.env.example
!.env.*.example

# Private keys and local certificates
*.pem
*.key
*.p12
*.pfx

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local agent / tool state
.freebuff/

# Operator runtime state (workspace assignment mapping written by the server)
data/
*.tmp

# Vercel CLI link/state (never contains secrets, never commit it)
.vercel/

# Scratch assets from the Agent City / Crew / Voice reference-frame pipelines
.city-tmp/
.crew-tmp/
.voice-tmp/

