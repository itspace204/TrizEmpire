# TrizEmpire environment template
#
# Copy this file to `.env` in this directory (nexora/) and edit the copy:
#
#   cp .env.example .env
#
# `.env` is gitignored — never commit it. The server loads nexora/.env on
# startup (plain `npm start`); variables already set in the operating system
# environment always take precedence over the file.
#
# Every variable below is optional for LOCAL loopback use; the defaults shown
# are what the server uses when the variable is unset. Read the comments —
# production has stricter rules and the server enforces them at startup.

# ── Runtime ─────────────────────────────────────────────────────────────

# development | test | production (unset = local mode).
# production enables Secure session cookies AND requires authentication.
#NODE_ENV=production

# TCP port. 0 = ephemeral (tests/CI only; rejected when NODE_ENV=production).
PORT=57004

# Bind address. Defaults to loopback. A non-loopback value requires
# ALLOW_REMOTE_HOST=true AND a configured admin hash, or the server refuses
# to start.
HOST=127.0.0.1

# Explicit opt-in for non-loopback binds. This is NOT authentication.
#ALLOW_REMOTE_HOST=true

# ── Authentication (no default credentials exist) ───────────────────────

# Generate with: node scripts/hash-password.js   (password typed on stdin)
# Leave empty (or unset) for local no-login mode. REQUIRED when
# NODE_ENV=production — the server will not start without it.
# The value is a secret: keep it only in your private .env / secret manager.
TRIZ_ADMIN_PASSWORD_HASH=

# Optional second, non-admin account (role: operator). Same format.
TRIZ_OPERATOR_PASSWORD_HASH=

# ── Sessions ────────────────────────────────────────────────────────────

# Idle timeout in minutes (default 480 = 8h).
#TRIZ_SESSION_TTL_MINUTES=480

# Absolute lifetime in minutes (default 1440 = 24h).
#TRIZ_SESSION_ABS_MINUTES=1440

# Force Secure session cookies without full production mode (useful behind
# HTTPS on a staging host). production enables this automatically.
#TRIZ_SECURE_COOKIE=true

# ── Hermes backend ──────────────────────────────────────────────────────

# Server-side upstream for live status. Only the fixed /api/status path is
# ever fetched — this can never become an open network proxy. Must be
# reachable from the TrizEmpire server, not from visitors' browsers.
#HERMES_BASE_URL=http://127.0.0.1:9119

# URL handed to the operator's own browser for the LOCAL-ONLY embedded
# console (it must resolve on the operator machine). Set to empty on remote
# deployments to disable the console embed:
#   HERMES_PUBLIC_URL=
#HERMES_PUBLIC_URL=http://127.0.0.1:9119

# Per-attempt upstream timeout in milliseconds (default 3000; one retry on
# network errors).
#HERMES_TIMEOUT_MS=3000
