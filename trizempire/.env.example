# TrizEmpire environment template
#
# Copy this file to `.env` in this directory (trizempire/) and edit the copy:
#
#   cp .env.example .env
#
# `.env` is gitignored — never commit it. The server loads trizempire/.env on
# startup (plain `npm start`); variables already set in the operating system
# environment always take precedence over the file.
#
# Every variable below is optional for LOCAL loopback use; the defaults shown
# are what the server uses when the variable is unset. Read the comments —
# production has stricter rules and the server enforces them at startup.

# ── Runtime ─────────────────────────────────────────────────────────────

# development | test | production (unset = local mode).
# production enables Secure session cookies AND requires authentication.
#NODE_ENV=production

# TCP port. 0 = ephemeral (tests/CI only; rejected when NODE_ENV=production).
PORT=57004

# Bind address. Defaults to loopback. A non-loopback value requires
# ALLOW_REMOTE_HOST=true AND a configured admin hash, or the server refuses
# to start.
HOST=127.0.0.1

# Explicit opt-in for non-loopback binds. This is NOT authentication.
#ALLOW_REMOTE_HOST=true

# ── Authentication (no default credentials exist) ───────────────────────

# Generate with: node scripts/hash-password.js   (password typed on stdin)
# Leave empty (or unset) for local no-login mode. REQUIRED when
# NODE_ENV=production — the server will not start without it.
# The value is a secret: keep it only in your private .env / secret manager.
TRIZ_ADMIN_PASSWORD_HASH=

# Optional second, non-admin account (role: operator). Same format.
TRIZ_OPERATOR_PASSWORD_HASH=

# ── Supabase Auth (optional second sign-in, alongside the local users) ─────
#
# When BOTH variables below are set, the sign-in form also accepts the email
# and password of a user from your Supabase project (Authentication → Users).
# The exchange happens server-side: the browser only ever talks to this
# server, and the Supabase access token never reaches the browser — the
# server mints its own session cookie after a successful sign-in.
#
# Project URL:  Supabase → Settings → API → Project URL
# Key:          the publishable/anon key (NOT the secret/service_role key —
#               that key would bypass all row-level security, never put it here)
#SUPABASE_URL=https://your-project-ref.supabase.co
#SUPABASE_ANON_KEY=eyJ...

# Role granted to a Supabase sign-in: admin (default) or operator.
#TRIZ_SUPABASE_ROLE=admin

# ── Sessions ────────────────────────────────────────────────────────────

# Idle timeout in minutes (default 480 = 8h).
#TRIZ_SESSION_TTL_MINUTES=480

# Absolute lifetime in minutes (default 1440 = 24h).
#TRIZ_SESSION_ABS_MINUTES=1440

# Stateless (HMAC-signed) sessions — REQUIRED on serverless hosts (Vercel),
# where function instances share no memory and would each reject the others'
# session tokens. Generate with: openssl rand -hex 32
# Effects to understand before setting it:
#   * sessions live inside the cookie: idle timeout is NOT tracked, only
#     the absolute lifetime above (keep TRIZ_SESSION_ABS_MINUTES short);
#   * a signed cookie cannot be revoked before expiry — rotating this
#     secret signs everyone out at once.
#TRIZ_SESSION_SECRET=

# Force Secure session cookies without full production mode (useful behind
# HTTPS on a staging host). production enables this automatically.
#TRIZ_SECURE_COOKIE=true

# ── Hermes backend ──────────────────────────────────────────────────────

# Server-side upstream for live status. Only the fixed, allowlisted paths
# are ever fetched (/api/status, /api/profiles, /api/profiles/sessions) —
# this can never become an open network proxy. Must be reachable from the
# TrizEmpire server, not from visitors' browsers.
#HERMES_BASE_URL=http://127.0.0.1:9119

# URL handed to the operator's own browser for the LOCAL-ONLY embedded
# console (it must resolve on the operator machine). Set to empty on remote
# deployments to disable the console embed:
#   HERMES_PUBLIC_URL=
#HERMES_PUBLIC_URL=http://127.0.0.1:9119

# Per-attempt upstream timeout in milliseconds (default 8000; one retry on
# network errors). The per-profile aggregation endpoints legitimately take
# several seconds when the messaging gateway is running — do not set this
# too low or healthy facts read as timeouts.
#HERMES_TIMEOUT_MS=8000

# Upstream session token for the per-agent crew data
# (GET /api/hermes/agents → Hermes /api/profiles*). Hermes keeps those paths
# off its public list: start the Hermes dashboard with the SAME value as
# HERMES_DASHBOARD_SESSION_TOKEN, then repeat that value here. It is sent as
# X-Hermes-Session-Token, only to the allowlisted upstream paths, never to
# browsers. SECRET — keep it in your private .env only.
# Leave empty (default): per-agent data is reported as "unconfigured" and
# the crew falls back to global backend signals instead of guessing.HERMES_SESSION_TOKEN=

# ── Workspace mapping ──────────────────────────────────────────────────

# Where the operator's workspace→agent assignment (saved from the cockpit's
# ＋ ASSIGN panel) is persisted. Default: data/workspaces.json inside the
# app directory (on Vercel: /tmp, which is wiped on every deploy). Point it
# outside a read-only app tree on deployments (systemd: see ReadWritePaths
# in deploy/trizempire.service). Relative paths resolve against the app
# directory. The file holds only profile names — no secrets — but treat it
# as operator state, not config to commit.
#TRIZ_WORKSPACES_FILE=data/workspaces.json

# Where the MISSIONS page's records (the operator's work orders) persist —
# one JSON document, validated before every write. Same three backends as
# the mapping above: this file by default, or KV/Neon when configured with
# the SAME variables (precedence Neon > KV > file). Default:
# data/missions.json inside the app directory (on Vercel: /tmp, wiped on
# every deploy — set KV or Neon for durable mission history).
#TRIZ_MISSIONS_FILE=data/missions.json

# ── Neon (serverless Postgres) ───────────────────────────────────────────
#
# Optional durable store for that same workspace mapping — the third backend
# after the file and Upstash KV stores, and the one that wins when configured
# (Neon > KV > file). The table (trizempire_settings) is created automatically
# on first use; only parameterized queries are ever sent.
#
# Connection string: Neon console → Connection Details → Connection string
# (postgres://user:pass@host/db?sslmode=require). The Vercel Marketplace
# Neon integration injects DATABASE_URL, which also works.
# SECRET: it contains the database password — never commit it, never log it.
#NEON_DATABASE_URL=
#DATABASE_URL=

# Upstash-compatible Redis REST store for that mapping (serverless hosts
# have a read-only filesystem). Takes precedence over the file store when
# set, and is overridden by Neon when both are set. Both variable pairs work — Vercel Marketplace "Upstash Redis"
# injects KV_REST_API_URL / KV_REST_API_TOKEN; Upstash's own docs use
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN. Both must be set
# together. SECRET — keep in your private .env / platform env only.
#KV_REST_API_URL=
#KV_REST_API_TOKEN=

# Trust X-Forwarded-For / X-Real-IP for rate-limit bucketing. Automatic on
# Vercel (VERCEL=1). Enable manually only behind a reverse proxy YOU
# control — on a directly-exposed server it lets clients spoof their IP.
#TRIZ_TRUST_PROXY=true
