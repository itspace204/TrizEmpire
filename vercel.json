{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/check-env.js",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?__triz_vc_original_path=/$1"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "trizempire/**",
      "maxDuration": 30
    }
  }
}
